# Absolute origin of the FixMate backend.
# Browsers never call this origin directly: API requests go to the frontend
# origin and are proxied through the `/api/:path*` rewrite in next.config.ts,
# which keeps Better Auth session cookies first-party.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional build-time override for the rewrite/proxy destination. When unset,
# NEXT_PUBLIC_API_URL is used.
# API_PROXY_TARGET=
